# ---------------------------------------------------------------
# Optional demo secret for the ESO acceptance test.
# The value is generated by an EPHEMERAL password and written through a
# WRITE-ONLY argument, so it never appears in the plan, the state file
# or Git. Only Secrets Manager (and Kubernetes, via ESO) holds it.
# ---------------------------------------------------------------
ephemeral "random_password" "demo" {
  count = var.create_demo_secret ? 1 : 0

  length  = 24
  special = false
}

resource "aws_secretsmanager_secret" "demo" {
  #checkov:skip=CKV_AWS_149:Uses the AWS-managed aws/secretsmanager key; no customer KMS key, consistent with the project's no-KMS cost decision
  #checkov:skip=CKV2_AWS_57:Demo secret with a generated value; rotation is not meaningful for the ESO sync test
  count = var.create_demo_secret ? 1 : 0

  name        = "${var.secrets_prefix}/demo"
  description = "Demo secret synced into Kubernetes by External Secrets Operator."

  # 0 = delete immediately on destroy, so the same name can be re-created
  # on the next rebuild. Production should keep a 7-30 day window.
  recovery_window_in_days = var.secret_recovery_window_days

  tags = var.tags
}

resource "aws_secretsmanager_secret_version" "demo" {
  count = var.create_demo_secret ? 1 : 0

  secret_id = aws_secretsmanager_secret.demo[0].id
  secret_string_wo = jsonencode({
    username = "demo"
    password = ephemeral.random_password.demo[0].result
  })
  # Write-only values are not stored, so Terraform cannot detect changes.
  # Increase this number to write a new value.
  secret_string_wo_version = 1
}
